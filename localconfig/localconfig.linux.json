{
  "asr": {
    "enabled": true,
    "engine": "funasr",
    "model": "iic/speech_paraformer_asr_nat-zh-cn-16k-common-vocab8358-tensorflow1",
    "input_audio": "/home/quark/test.wav",
    "language": "zh_CN",
    "enable_recording": false,
    "record_duration": 5.0,
    "record_sample_rate": 16000
  },
  "llm": {
    "enabled": true,
    "model_path": "models/Qwen3-1.7B-w8a8-rk3588.rkllm",
    "max_context_len": 512,
    "max_new_tokens": 32,
    "temperature": 0.8,
    "top_p": 0.95,
    "system_prompt": "你是AI助手，用一句话简短回答。/no_think"
  },
  "tts": {
    "enabled": true,
    "engine": "piper",
    "model": "zh_CN-huayan-medium",
    "model_path": "models/piper/zh_CN-huayan-medium.onnx",
    "speed": 1.0,
    "quality": "medium"
  },
  "output": {
    "audio_path": "output/llm_response_piper.wav",
    "format": "wav",
    "sample_rate": 22050
  },
  "cache": {
    "modelscope_cache": ".cache/modelscope",
    "enable_cache": true
  },
  "device": {
    "platform": "rk3588",
    "npu_enabled": true,
    "memory_optimization": true
  },
  "wakeword": {
    "enabled": false,
    "engine": "snowboy",
    "model_paths": ["models/snowboy/zhixia.umdl"],
    "keyword_names": ["知匣"],
    "sensitivity": 0.5,
    "audio_gain": 1.0,
    "apply_frontend": false,
    "record_duration": 5.0,
    "wake_sound": "ding"
  },
  "logging": {
    "level": "INFO",
    "enable_debug": false
  }
}
